# Copy to .env (never commit .env) or set these as environment variables.
# ASP.NET Core maps "__" to ":" so Jwt__Key is the configuration key Jwt:Key.

# PostgreSQL connection for the API
ConnectionStrings__Default=Host=localhost;Port=5432;Database=relieflink;Username=postgres;Password=CHANGE_ME

# JWT signing key: generate a long random value, at least 32 characters
#   openssl rand -base64 48
Jwt__Key=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Apply migrations on startup, and optionally create one demo user per role (development only)
Database__MigrateOnStartup=true
Seed__Enabled=true
Seed__DemoPassword=CHOOSE_A_DEMO_PASSWORD_1

# Allowed browser origins for the React app (comma-free array form for env vars)
Cors__Origins__0=http://localhost:5173

# Used by the tests: any PostgreSQL server where the user can create databases
ConnectionStrings__TestDb=Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=CHANGE_ME
